# 复制成 .env 再改。.env 不要提交进 git。

# 后台登录密码。改完密码需要重启服务才生效。
ADMIN_PASSWORD="换成你自己的密码"

# token 签名密钥。随便一串长随机字符串，例如：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 不填会退化成用 ADMIN_PASSWORD 派生（能用，但改密码会把登录态全部踢掉）。
SESSION_SECRET=""

# 登录状态保持多久（小时）。默认 168 = 7 天。
TOKEN_TTL_HOURS=168

# 监听端口。只绑 127.0.0.1，外网访问一律走 nginx。
PORT=3001
HOST=127.0.0.1

# 单张图片上传上限（MB）
MAX_UPLOAD_MB=5

# 简历 PDF 上传上限（MB）。base64 编码后体积约 1.33 倍，
# 改这里要同步 index.js 的 express.json limit 和 deploy/nginx.conf 的 client_max_body_size。
MAX_PDF_MB=10
