# 复制成 .env 再改。.env 不要提交进 git。

# 后台登录密码。改完密码需要重启服务才生效。
# 默认给的是 123456，本地跑着玩够用。**部署到公网一定要改掉** ——
# 后台是公开可访问的，知道这个默认值的人都能登进来改内容。
ADMIN_PASSWORD="123456"

# token 签名密钥。随便一串长随机字符串，例如：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 不填会退化成用 ADMIN_PASSWORD 派生（能用，但改密码会把登录态全部踢掉）。
SESSION_SECRET=""

# 登录状态保持多久（小时）。默认 168 = 7 天。
TOKEN_TTL_HOURS=168

# 监听端口。只绑 127.0.0.1，外网访问一律走 nginx。
PORT=3001
HOST=127.0.0.1

# 单张图片上传上限（MB）
MAX_UPLOAD_MB=5

# 简历 PDF 上传上限（MB）。
# index.js 的 express.json limit 是照着这个值算出来的，不用管；
# 但 nginx 的 client_max_body_size 是写死在 deploy/nginx.conf 里的，调大了要手动同步 ——
# 忘了的话进程启动时会打一行 [warn] 提醒你改成多少。
MAX_PDF_MB=10

# data.json 快照：隔多少分钟留一份、最多留几份，存在 server/backups/。
# 另有一份 data.json.bak 永远是上一版。后台保存是防抖的，一次编辑会打出
# 很多个 PUT，所以快照按间隔留 —— 每次都留的话留下的全是中间态。
BACKUP_INTERVAL_MINUTES=10
BACKUP_KEEP=20
